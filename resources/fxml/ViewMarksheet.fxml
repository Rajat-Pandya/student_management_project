<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.geometry.Pos?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="controller.ViewMarksheetController"
            stylesheets="@../css/styles.css"
            prefWidth="1200" prefHeight="720"
            styleClass="app"
            fx:id="rootPane">

    <!-- Topbar / header -->
    <top>
        <HBox spacing="12" alignment="CENTER_LEFT" styleClass="topbar">
            <padding>
                <Insets top="12" right="12" bottom="12" left="12" />
            </padding>

            <VBox spacing="2" alignment="CENTER_LEFT">
                <Label text="Student Marksheet" styleClass="title" />
                <Label fx:id="lblSubTitle"
                       text="View detailed marks of individual student"
                       styleClass="subtitle" />
            </VBox>

            <Region HBox.hgrow="ALWAYS" />

            <HBox spacing="10" alignment="CENTER_RIGHT">
                <!-- kept only export + refresh -->
                <Button text="Export PDF" onAction="#onExportPdf" styleClass="btn-success" />
                <Button text="Refresh" onAction="#onRefresh" styleClass="nav-secondery" />
            </HBox>
        </HBox>
    </top>

    <center>
        <VBox spacing="16">
            <padding>
                <Insets top="20" right="20" bottom="20" left="20" />
            </padding>

            <!-- Selector row: Semester + Student + Load -->
            <HBox spacing="12" alignment="CENTER_LEFT">
                <Label text="Semester:" />
                <ComboBox fx:id="cmbSemester" prefWidth="100" />

                <Label text="Student:" />
                <ComboBox fx:id="cmbStudent" prefWidth="320" />

                <Button text="Load" onAction="#handleLoad" styleClass="btn-primary" />
                <Label fx:id="lblLoadingHint" textFill="#7A7A7A" style="-fx-padding:0 0 0 10;" />
            </HBox>

            <!-- Student Info Card -->
            <HBox spacing="16" styleClass="card" alignment="CENTER_LEFT">
                <VBox spacing="6" alignment="CENTER_LEFT">
                    <Label fx:id="lblStudentName" text="Name: -" style="-fx-font-size:18px; -fx-font-weight:700; -fx-text-fill: #222222;" />
                    <Label fx:id="lblRoll" text="Roll: -" style="-fx-font-size:13px; -fx-text-fill: #7A7A7A;" />
                    <HBox spacing="12">
                        <Label fx:id="lblCourse" text="Course: -" style="-fx-font-size:13px; -fx-text-fill: #333333;" />
                        <Label fx:id="lblSemester" text="Semester: -" style="-fx-font-size:13px; -fx-text-fill: #333333;" />
                        <Label fx:id="lblAttendance" text="Attendance: -" style="-fx-font-size:13px; -fx-text-fill: #333333;" />
                    </HBox>
                </VBox>

                <Region HBox.hgrow="ALWAYS" />

                <VBox alignment="CENTER_RIGHT" spacing="6">
                    <Label text="Summary" style="-fx-font-size:13px; -fx-text-fill: #7A7A7A;" />
                    <Label fx:id="lblTotal" text="Total: -" style="-fx-font-size:14px; -fx-font-weight:600;" />
                    <Label fx:id="lblAverage" text="Average: -" style="-fx-font-size:14px; -fx-font-weight:600;" />
                    <Label fx:id="lblPercentage" text="Percentage: -" style="-fx-font-size:14px; -fx-font-weight:600;" />
                </VBox>
            </HBox>

            <!-- Marks table card -->
            <VBox spacing="8" styleClass="card" VBox.vgrow="ALWAYS">
                <HBox alignment="CENTER_LEFT">
                    <Label text="Marks" style="-fx-font-size:14px; -fx-font-weight:600;" />
                    <Region HBox.hgrow="ALWAYS" />
                </HBox>

                <TableView fx:id="tblMarks" prefHeight="420" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colSno" text="#" prefWidth="50" />
                        <TableColumn fx:id="colSubject" text="Subject" prefWidth="300" />
                        <TableColumn fx:id="colCode" text="Code" prefWidth="120" />
                        <TableColumn fx:id="colMarks" text="Marks" prefWidth="90" />
                        <TableColumn fx:id="colGrade" text="Grade" prefWidth="90" />
                        <TableColumn fx:id="colFaculty" text="Faculty" prefWidth="240" />
                        <TableColumn fx:id="colSemester" text="Sem" prefWidth="70" />
                    </columns>
                </TableView>
            </VBox>

        </VBox>
    </center>
</BorderPane>
