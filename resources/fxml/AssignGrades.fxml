<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.String?>
<?import javafx.collections.FXCollections?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox prefHeight="720.0" prefWidth="1200.0" spacing="8" styleClass="pad"
      xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="controller.AssignGradesController"
      stylesheets="@../css/styles.css">

    <children>
        <!-- Top bar -->
        <HBox alignment="CENTER_LEFT" spacing="8" styleClass="topbar">
            <padding>
                <Insets bottom="8" left="8" right="8" top="8" />
            </padding>
            <Label text="Subject:" />
            <ComboBox fx:id="cmbSubjects" prefWidth="320" />
            <Region HBox.hgrow="ALWAYS" />
            <Button fx:id="btnAutoGrade" styleClass="btn-primary" onAction="#onAutoGrade" text="Auto Grade (from marks)" />
            <Button fx:id="btnRefresh" styleClass="btn-primary" onAction="#onRefresh" text="Refresh" />
        </HBox>

        <!-- Students table: ID column added -->
        <TableView fx:id="tblStudents" editable="true" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colSId" prefWidth="60" text="ID" />
                <TableColumn fx:id="colSName" prefWidth="300" text="Name" />
                <TableColumn fx:id="colSRoll" prefWidth="120" text="Roll" />
                <TableColumn fx:id="colGrade" prefWidth="120" text="Grade" />
            </columns>
        </TableView>

        <!-- Grade filter row -->
        <HBox alignment="CENTER_LEFT" spacing="8">
            <padding>
                <Insets bottom="8" left="8" right="8" top="8" />
            </padding>
            <Label text="Filter by Grade:" />
            <ComboBox fx:id="cmbGradeFilter" prefWidth="120">
                <items>
                    <FXCollections fx:factory="observableArrayList">
                        <String fx:value="A+" />
                        <String fx:value="A" />
                        <String fx:value="B+" />
                        <String fx:value="B" />
                        <String fx:value="C" />
                        <String fx:value="D" />
                        <String fx:value="F" />
                    </FXCollections>
                </items>
            </ComboBox>
            <Button fx:id="btnApplyGradeFilter" styleClass="btn-primary" onAction="#onApplyGradeFilter" text="Apply Filter" />
            <Button fx:id="btnClearGradeFilter" styleClass="btn-secondary" onAction="#onClearGradeFilter" text="Clear" />
        </HBox>

        <!-- Bottom bar -->
        <HBox alignment="CENTER_RIGHT" spacing="8">
            <padding>
                <Insets bottom="8" left="8" right="8" top="8" />
            </padding>
            <Button fx:id="btnSaveGrades" styleClass="btn-success" onAction="#onSaveGrades" text="Save Grades" />
        </HBox>
    </children>
</VBox>
