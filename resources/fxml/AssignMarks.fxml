<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox prefHeight="720.0" prefWidth="1200.0" spacing="8" styleClass="pad"
      xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="controller.AssignMarksController"
      stylesheets="@../css/styles.css">

    <children>
        <!-- Top bar: Subject selection and Refresh -->
        <HBox alignment="CENTER_LEFT" spacing="8" styleClass="topbar">
            <padding>
                <Insets bottom="8" left="8" right="8" top="8" />
            </padding>
            <Label text="Subject:" />
            <ComboBox fx:id="cmbSubjects" prefWidth="320" />
            <Region HBox.hgrow="ALWAYS" />
            <Button fx:id="btnRefresh" styleClass="btn-primary" onAction="#onRefresh" text="Refresh" />
        </HBox>

        <!-- Table of students (ID column included) -->
        <TableView fx:id="tblStudents" editable="true" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colSId" prefWidth="60" text="ID" />
                <TableColumn fx:id="colSName" prefWidth="300" text="Name" />
                <TableColumn fx:id="colSRoll" prefWidth="120" text="Roll" />
                <TableColumn fx:id="colMarks" prefWidth="100" text="Marks" />
            </columns>
        </TableView>

        <!-- Filter row -->
        <HBox alignment="CENTER_LEFT" spacing="8">
            <padding>
                <Insets bottom="8" left="8" right="8" top="8" />
            </padding>
            <Label text="Filter by Marks:" />
            <TextField fx:id="txtMinMarks" prefWidth="80" promptText="Min" />
            <Label text="—" />
            <TextField fx:id="txtMaxMarks" prefWidth="80" promptText="Max" />
            <Button fx:id="btnApplyFilter" styleClass="btn-primary" onAction="#onApplyFilter" text="Apply Filter" />
            <Button fx:id="btnClearFilter" styleClass="btn-secondary" onAction="#onClearFilter" text="Clear" />
        </HBox>

        <!-- Bottom row: Save button -->
        <HBox alignment="CENTER_RIGHT" spacing="8">
            <padding>
                <Insets bottom="8" left="8" right="8" top="8" />
            </padding>
            <Button fx:id="btnSaveMarks" styleClass="btn-success" onAction="#onSaveMarks" text="Save Marks" />
        </HBox>
    </children>
</VBox>
