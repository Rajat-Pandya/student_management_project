<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox prefHeight="720.0" prefWidth="1200.0" spacing="12" styleClass="pad"
      xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="controller.AssignSubjectsController"
      stylesheets="@../css/styles.css">

    <HBox alignment="CENTER_LEFT" spacing="12" styleClass="topbar">
        <Label text="Faculty:" />
        <ComboBox fx:id="cmbFaculty" prefWidth="260" promptText="Select faculty" />
        <Label text="Semester:" />
        <ComboBox fx:id="cmbSemester" prefWidth="120" promptText="Sem" />
        <Label text="Subject:" />
        <ComboBox fx:id="cmbSubject" prefWidth="260" promptText="Select subject" />
        <!-- Assign button: positive action -->
        <Button fx:id="btnAssign" onAction="#handleAssign" styleClass="btn-success" text="Assign Subject" />
    </HBox>

    <TableView fx:id="tblAssignments" VBox.vgrow="ALWAYS">
        <columns>
            <!-- ID column added to match controller -->
            <TableColumn fx:id="colId" prefWidth="60" text="ID" />
            <TableColumn fx:id="colFaculty" prefWidth="200" text="Faculty" />
            <TableColumn fx:id="colSubject" prefWidth="220" text="Subject" />
            <TableColumn fx:id="colSem" prefWidth="100" text="Semester" />
            <TableColumn fx:id="colAssignedAt" prefWidth="140" text="Assigned At" />
            <TableColumn fx:id="colAction" prefWidth="120" text="Action" />
        </columns>
    </TableView>

    <HBox alignment="CENTER_RIGHT" spacing="8" style="-fx-padding: 0 8 8 0;">
        <!-- Refresh button: primary (keeps consistent look) -->
        <Button fx:id="btnRefreshList" onAction="#handleRefresh" text="Refresh" styleClass="btn-primary" />
    </HBox>

</VBox>
